.DS_Store
.env
.env.*
!.env.example
!**/.env.example
# Factory default .env baked into Pi image (not a secret)
!os/device-image/layers/**/.env
node_modules/
dist/
coverage/
.vscode/
.idea/
*.log

# Runtime data directories (bind-mounted Docker volumes)
deploy/compose/data/

# Pi image build artifacts
os/device-image/images/*
!os/device-image/images/.gitkeep
os/device-image/output/*
!os/device-image/output/.gitkeep
