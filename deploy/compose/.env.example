# SeaTurtleOS — Bootstrap Environment Variables
# Copy to .env and adjust before first run:
#   cp .env.example .env

# Master bootstrap password used by services that support env-based credentials.
# Used by: Grafana (admin), Node-RED (admin + credentialSecret), Mosquitto (MQTT user).
# NOT used by: NPM (built-in first-login flow), Portainer (interactive setup).
SEATURTLE_INITIAL_PASSWORD=changeseaturtle

# MQTT credentials — used by Mosquitto, Node-RED, and Signal K MQTT gateway.
SEATURTLE_MQTT_USER=seaturtle
SEATURTLE_MQTT_PASSWORD=${SEATURTLE_INITIAL_PASSWORD:-changeseaturtle}

# Timezone (IANA format). Used by Node-RED, Grafana, and Signal K.
TZ=UTC
