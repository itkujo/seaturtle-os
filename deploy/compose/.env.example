# SeaTurtleOS — Bootstrap Environment Variables
# Copy to .env and adjust before first run:
#   cp .env.example .env

# Master bootstrap password used by services that support env-based credentials.
# Used by: Node-RED (credentialSecret), Grafana (admin password).
# NOT used by: NPM (uses built-in first-login flow), Portainer (interactive setup).
SEATURTLE_INITIAL_PASSWORD=changeseaturtle

# Timezone (IANA format). Used by Node-RED and Grafana.
TZ=UTC
